{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.next/**"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "rules": {
    "no-debugger": "error",
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error"
  }
}
