# ==========================================
# Application
# ==========================================
NODE_ENV=development
APP_NAME=Boilerplate API
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
# Express "trust proxy": true, false, a hop count such as 1, or an address list.
TRUST_PROXY=

# ==========================================
# PostgreSQL
# Matches docker-compose.yml: user app, password app, database app.
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_PASSWORD=app

# ==========================================
# Database Connection
# ==========================================
DATABASE_SSL=false
DATABASE_LOGGING=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# ==========================================
# Authentication
# ==========================================
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_ACCESS_TOKEN_COOKIE_NAME=access_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# CORS
# ==========================================
WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002
CORS_ALLOWED_ORIGINS=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
LOG_PRETTY=true

# ==========================================
# Rate Limiting
# Validated at startup. No guard applies these values yet.
# ==========================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ==========================================
# Redis (Optional)
# Validated at startup. No module connects to Redis yet.
# ==========================================
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Email (Optional)
# Validated at startup. No mailer is configured yet.
# ==========================================
EMAIL_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ==========================================
# File Storage
# ==========================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=./uploads

# S3 (Required only when STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
